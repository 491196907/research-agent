# 这是 Secrets / 本地 .streamlit/secrets.toml 的模板（复制成 secrets.toml 再填真实值）
# ⚠️ 别把填好的 secrets.toml 提交到 git（.gitignore 里已经挡住了）

# 必须：对话模型
DEEPSEEK_API_KEY = "sk-你的key"

# 可选：语义检索（不配就会退化成"字面检索"）
# 注册：https://cloud.siliconflow.cn → API 密钥
SILICONFLOW_API_KEY = "sk-你的key"

# 可选：联网搜索（不配就走 Bing 网页版；配了更稳，云服务器尤其推荐）
# 注册：https://tavily.com → API Keys（有免费额度）
TAVILY_API_KEY = "tvly-你的key"
